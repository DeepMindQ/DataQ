# ── Dataq Software static export — build environment ─────────────────────
# Copy to .env.production.local (gitignored) for local export builds, or set
# these as repository secrets in GitHub Actions (Top-20 #2/#5).

# Public site URL — the canonical identity for og:url, canonical, sitemap,
# robots and JSON-LD. Current live root (GitHub Pages project site):
NEXT_PUBLIC_SITE_URL=https://deepmindq.github.io/DataQ
# When the custom domain is properly attached to GitHub Pages (CNAME + DNS +
# HTTPS verified), flip this back to:
#   NEXT_PUBLIC_SITE_URL=https://www.dataqsoft.com

# Contact + newsletter form endpoint (Web3Forms). Create a free access key at
# https://web3forms.com and set it here. WITHOUT IT the forms never fake a
# submission — the contact form offers a prefilled mailto handoff instead.
NEXT_PUBLIC_FORM_ACCESS_KEY=

# Privacy-friendly analytics (Plausible — cloud or self-hosted CE). The
# script loads ONLY after the visitor accepts analytics in the consent
# dialog; with these unset nothing loads and no requests are made.
NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=deepmindq.github.io
