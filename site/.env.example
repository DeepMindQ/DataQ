# Public site URL (used for canonical URLs, sitemap, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://www.dataqsoft.com

# Contact form endpoint (Web3Forms). Create an access key at https://web3forms.com
# and set it here; without it the form runs in demo mode.
NEXT_PUBLIC_FORM_ACCESS_KEY=

# Google Analytics 4 measurement id (loaded only after cookie consent)
NEXT_PUBLIC_GA_ID=
